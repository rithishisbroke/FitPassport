# Copy this file to .env.local and fill in the values from your Supabase project
# (Project Settings → API). .env.local is git-ignored and must never be committed.

# Required for authentication.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public origin used in confirmation and password-reset email links.
# Optional in development (the request host is used); set it in production,
# for example https://fitpassport.example.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000
